# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Ignore Oracle JDK
oracleJdk-26/

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# VS Code & IDEs
.vscode/
.idea/

# Local databases
instance/
*.db
*.sqlite
*.sqlite3

# Logs & temp
*.log
tmp/
temp/

# User-uploaded files - never commit
static/uploads/resumes/*
!static/uploads/resumes/.gitkeep
static/uploads/posts/*
!static/uploads/posts/.gitkeep