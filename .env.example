# CareerOS environment variables
# Copy this file to .env for local development. Never commit real secrets.

# Required in production (Vercel). Also recommended locally.
SECRET_KEY=change-me-to-a-long-random-string

# Production database (required on Vercel).
# Cloud MySQL (PlanetScale, Aiven, AWS RDS, etc.):
# DATABASE_URL=mysql://USER:PASSWORD@HOST/DB
# Hosted PostgreSQL (Neon, Supabase, etc.):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Local development MySQL / XAMPP (if DATABASE_URL is unset):
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DB=application

# Flask environment
# FLASK_ENV=development
# CAREEROS_ENV=development

# Email / OTP (required in Vercel production; configure these in Project Environment Variables)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# AI providers (at least one of GEMINI_API_KEY or OPENROUTER_API_KEY for chat/roadmaps)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional integrations
YOUTUBE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Payments (optional — dummy checkout is used when Razorpay keys are absent)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Upload size cap in bytes (default 8MB)
# MAX_CONTENT_LENGTH=8388608
